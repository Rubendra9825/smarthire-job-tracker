# SmartHire Backend — Environment Variables
# ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to git!

# Server port
PORT=5000

# MongoDB connection string (add in Stage 4)
# Get this from MongoDB Atlas → Connect → Connect your application
MONGO_URI=mongodb://localhost:27017/smarthire

# JWT secret key (add in Stage 5)
# Use a long random string — never share this!
JWT_SECRET=your_super_secret_jwt_key_here

# JWT expiry duration
JWT_EXPIRE=7d
